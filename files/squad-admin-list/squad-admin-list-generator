    private function fetchMembers($gameIdsByUserName): void
    {
        $members = [
            ...array_values((array)($this->curlRequest("https://api.7cav.us/api/v1/roster/ROSTER_TYPE_COMBAT", true, $this->cavApiKey)->profiles)),
            ...array_values((array)($this->curlRequest("https://api.7cav.us/api/v1/roster/ROSTER_TYPE_RESERVE", true, $this->cavApiKey)->profiles)),
            ...array_values((array)($this->curlRequest("https://api.7cav.us/api/v1/roster/ROSTER_TYPE_ELOA", true, $this->cavApiKey)->profiles)),
        ];
        $this->members = [];
        foreach ($members as $member) {
            $hasSac = false;
            foreach ($member->records as $record) {
                if ($record->recordType === "RECORD_TYPE_GRADUATION" && str_contains(strtolower($record->recordDetails), "server administration course")) {
                    $hasSac = true;
                    break;
                }
            }
            $this->members[] = new Member(
                $member->user->username,
                $member->rank->rankShort,
                $gameIdsByUserName[$member->user->username]["steamId"] ?? "",
                $gameIdsByUserName[$member->user->username]["eosId"] ?? "",
                $hasSac,
                [
                    // prefix key with p to force keys to be string (avoids issues of key's being reassigned during array operations)
                    "p{$member->primary->positionId}",
                    ...array_map(fn($position) => "p{$position->positionId}", $member->secondaries),
                ]
            );
        }
    }

    private function getGameIds(string $spreadsheetId, string $sheetName): array
    {
        $gameIdsByUserName = [];
        $response = $this->curlRequest("https://docs.google.com/spreadsheets/d/$spreadsheetId/export?format=csv&sheet=$sheetName");
        foreach (explode("\n", $response) as $rowStr) {
            $row = str_getcsv($rowStr);
            if (!empty($row[0]) && $row[0] !== "Name") {
                $gameIdsByUserName[trim((string)$row[0])] = [
                    'eosId' => trim((string)$row[1]),
                    'steamId' => trim((string)$row[2]),
                ];
            }
        }
        return $gameIdsByUserName;
    }

    private function fetchPositions(): void
    {
        $this->positionGroups = [];
        foreach ($this->curlRequest("https://api.7cav.us/api/v1/milpacs/position/groups", true, $this->cavApiKey)->groups as $group) {
            $this->positionGroups[] = new PositionGroup(
                $group->groupTitle,
                // prefix id with p to force keys to be string (avoids issues of key's being reassigned during array operations)
                array_map(fn($position) => new Position("p{$position->positionId}", $position->positionTitle), $group->positions),
            );
        }
    }

    private function curlRequest(string $url, bool $getJson = false, ?string $authorization = null): mixed
    {
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
        curl_setopt($ch, CURLOPT_HTTPHEADER, array_filter([
            $getJson ? 'Accept: application/json' : null,
            $authorization ? "Authorization: {$authorization}" : null,
        ]));
        $response = curl_exec($ch);
        if (curl_errno($ch)) {
            throw new Exception("cURL error: " . curl_error($ch));
        }
        curl_close($ch);
        sleep(1);
        if ($getJson) {
            try {
                return json_decode($response, false, 512, JSON_THROW_ON_ERROR);
            } catch (Exception $e) {
                throw new Exception("{$e->getMessage()} / url: $url / response content: $response");
            }
        }
        return $response;
    }
};

class Member
{
    public function __construct(
        public string $username,
        public string $rankShort,
        public string $steamId,
        public string $eosId,
        public bool   $hasSac,
        public array  $positionIdsWithPrefix,
    )
    {
    }
}

class PositionGroup
{
    public function __construct(
        public string $title,
        /**
         * @var Position[]
         */
        public array  $positions,
    )
    {
    }
}

class Position
{
    public function __construct(
        public string $idWithPrefix,
        public string $title,
    )
    {
    }
}
